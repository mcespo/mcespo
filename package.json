{
  "name": "mcespo",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "check-updates": "npm outdated",
    "check": "astro check",
    "brand-images": "node scripts/brand-images.mjs",
    "serve:dist": "npx --yes serve@14 dist -l 4400",
    "a11y": "npx --yes pa11y-ci@4 --sitemap http://localhost:4400/sitemap-0.xml --sitemap-find https://mcespo.com --sitemap-replace http://localhost:4400",
    "test:a11y": "npm run a11y && THEME=dark npm run a11y",
    "test:links": "lychee --config lychee.toml --no-progress 'dist/**/*.html' dist/llms.txt",
    "fonts": "node scripts/fonts.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3"
  }
}
