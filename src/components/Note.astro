---
/**
 * Note — a sticky-note callout, styled like the notes in the
 * writing stream. Used inline within a post's body.
 *
 * Usage:
 *   <Note label="A note in the margin">
 *     psst — if you read to the end there's a small thing waiting. ↓
 *   </Note>
 */

interface Props {
  label?: string;
}

const { label = 'A note in the margin' } = Astro.props;
---

<aside class="note" role="note">
  <div class="label">{label}</div>
  <p><slot /></p>
</aside>
