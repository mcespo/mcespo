---
import LogoIcon from './LogoIcon.astro';
import { site } from '../site.config';
---

<style>
  footer {
    margin-block-start: 4.5rem;
    padding-block: 3rem 5rem;
    border-block-start: 1px solid var(--rule);
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-2);

    & :global(svg) {
      flex: none;
      color: var(--ink-3);
    }

    & a { color: var(--accent); }
  }
</style>

<footer>
  <LogoIcon size="2.25rem" />
  <p>
    Thanks for stopping by. This site is hand-built, has no tracking, and is
    best read slowly. Follow by <a class="u" href="/feed.xml">RSS</a> or
    <a class="u" href={`mailto:${site.email}`}>email</a>.
  </p>
</footer>
