---
interface Props {
  src: string;
  poster?: string;
  caption?: string;
  ratio?: string;
  /** Autoplay is always muted; browsers block it otherwise. */
  autoplay?: boolean;
  loop?: boolean;
}

const { src, poster, caption, ratio = '16/9', autoplay = false, loop = false } = Astro.props;
---

<figure>
  <!-- preload="metadata" fetches only the poster frame and duration until someone presses play. -->
  <video
    {src}
    {poster}
    controls
    playsinline
    preload="metadata"
    autoplay={autoplay}
    muted={autoplay}
    loop={loop}
    class="w-full rounded-[0.375rem]"
    style={`aspect-ratio: ${ratio}`}
  >
    <a href={src}>Download the video</a>
  </video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
