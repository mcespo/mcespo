---
/**
 * Plate — a figure with an italic caption. Inside a post it breaks
 * out of the reading column on wide screens.
 *
 * When no `src` is provided the frame renders a striped placeholder.
 * The `ratio` prop sets the CSS aspect-ratio of the frame.
 *
 * Usage:
 *   <Plate caption="<em>Project Name</em> — final comp, 2025." label="photo — notebook spread" />
 *   <Plate num="Fig. 01" src="/img/photo.jpg" alt="Studio corner" caption="35mm, overcast." />
 */

interface Props {
  /** Optional figure label, e.g. "Fig. 02" — prefixes the caption */
  num?: string;
  /** Caption HTML string — em and other inline elements are allowed */
  caption: string;
  /** Placeholder text shown inside an empty frame */
  label?: string;
  /** Optional image URL; omit to render a placeholder frame */
  src?: string;
  /** Alt text for the image */
  alt?: string;
  /** CSS aspect-ratio applied to the frame — defaults to "16/9" */
  ratio?: string;
  /** Extra classes on the outer figure element */
  class?: string;
}

const {
  num,
  caption,
  label = '',
  src,
  alt = '',
  ratio = '16/9',
  class: className = '',
} = Astro.props;
---

<style>
  .frame {
    border-radius: 0.375rem;
    overflow: hidden;
    display: grid;
    place-items: center;

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .placeholder {
    background: repeating-linear-gradient(
      135deg,
      var(--paper-2) 0 0.625rem,
      color-mix(in oklch, var(--paper-2) 80%, var(--ink) 6%) 0.625rem 1.25rem
    );
    font-family: var(--f-mono);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
</style>

<figure class={className}>
  <div class:list={['frame', { placeholder: !src }]} style={`aspect-ratio: ${ratio}`}>
    {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : label}
  </div>
  <figcaption>
    {num && <>{num}. </>}<span set:html={caption} />
  </figcaption>
</figure>
