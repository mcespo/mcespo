---
/**
 * Captioned figure that breaks out of the post column on wide screens.
 * Without `src` it renders a striped placeholder showing `label`.
 */

type Props = {
  /** Trusted HTML, so captions can use <em>. */
  caption: string;
  /** Prefixes the caption, e.g. "Fig. 02". */
  num?: string;
  ratio?: string;
  class?: string;
} & (
  // An image must say what it shows; the type check catches a missing alt.
  | { src: string; alt: string; label?: never }
  | { src?: never; alt?: never; label?: string }
);

const { caption, num, ratio = '16/9', class: className, src, alt, label } = Astro.props;
---

<style>
  .frame {
    border-radius: 0.375rem;
    overflow: hidden;
    display: grid;
    place-items: center;

    & img {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }
  }

  .placeholder {
    background: repeating-linear-gradient(
      135deg,
      var(--paper-2) 0 0.625rem,
      color-mix(in oklch, var(--paper-2) 80%, var(--ink) 6%) 0.625rem 1.25rem
    );
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
</style>

<figure class={className}>
  <div class:list={['frame', { placeholder: !src }]} style={`aspect-ratio: ${ratio}`}>
    {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : label}
  </div>
  <figcaption>
    {num && <>{num}. </>}<span set:html={caption} />
  </figcaption>
</figure>
