---
import LogoIcon from './LogoIcon.astro';
import { site } from '../site.config';

interface Props {
  current?: 'writing' | 'projects' | 'contact';
}

const { current } = Astro.props;

const themes = ['auto', 'light', 'dark'] as const;
---

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block-start: 2.25rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: var(--text-brand);
    color: var(--ink);

    & :global(svg) {
      color: var(--ink-2);

      @media (prefers-reduced-motion: no-preference) {
        transition: rotate .6s cubic-bezier(.3, 1.4, .5, 1), color .6s;
      }
    }

    &:hover :global(svg) {
      color: var(--accent-2-strong);

      /* Hover-capable devices only, so the tilt doesn't stick after a tap. */
      @media (hover: hover) and (prefers-reduced-motion: no-preference) { rotate: -14deg; }
    }

    & span {
      font-family: var(--font-display);
      font-variation-settings: var(--dv);
    }
  }

  /* Wraps under the brand on narrow screens instead of hiding the nav, which the design left without a mobile fallback. */
  .end {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.375rem;
    font-size: var(--text-ui);
    color: var(--ink-2);
  }

  nav {
    display: flex;
    gap: 1.25rem;

    & [aria-current="page"] { color: var(--ink); }
  }

  .theme {
    display: flex;
    border: 1px solid var(--rule);
    border-radius: 999rem;
    padding: 0.1875rem;

    & button {
      cursor: pointer;
      font-size: 0.8em;
      color: var(--ink-3);
      padding: 0.25rem 0.625rem;
      border-radius: 999rem;
      text-transform: capitalize;
      transition: color 0.25s ease, background-color 0.25s ease;

      &[aria-pressed="true"] {
        background: var(--ink);
        color: var(--paper);
      }
    }
  }
</style>

<header class="reveal">
  <a class="brand" href="/" aria-label="Marvin Céspedes, home" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
    <LogoIcon size="2.2em" />
    <span>Marvin Céspedes</span>
  </a>

  <div class="end">
    {site.nav.length > 0 && (
      <nav aria-label="Primary">
        {site.nav.map(({ href, label, id }) => (
          <a href={href} aria-current={current === id ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    )}

    <div class="theme" role="group" aria-label="Color theme">
      {themes.map((mode) => (
        <button type="button" data-mode={mode} aria-pressed="false">{mode}</button>
      ))}
    </div>
  </div>
</header>

<script>
  type Mode = 'auto' | 'light' | 'dark';

  // Same storage key and auto rule as the inline script in BaseLayout.
  const KEY = 'mcespo.tweaks';
  const prefersDark = matchMedia('(prefers-color-scheme: dark)');
  const prefersLight = matchMedia('(prefers-color-scheme: light)');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme button');

  const readPrefs = (): Record<string, unknown> => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch { return {}; }
  };

  const storedMode = (): Mode => {
    const { darkMode } = readPrefs();
    return darkMode === 'dark' || darkMode === 'light' ? darkMode : 'auto';
  };

  // No system preference at all falls back to night hours (7 pm – 7 am).
  const autoIsDark = () => {
    if (prefersDark.matches) return true;
    if (prefersLight.matches) return false;
    const hour = new Date().getHours();
    return hour >= 19 || hour < 7;
  };

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  const apply = (mode: Mode) => {
    document.documentElement.classList.toggle('dark', mode === 'auto' ? autoIsDark() : mode === 'dark');
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.mode === mode));
    }
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const mode = button.dataset.mode as Mode;
      const { darkMode: _, ...prefs } = readPrefs();
      localStorage.setItem(KEY, JSON.stringify(mode === 'auto' ? prefs : { ...prefs, darkMode: mode }));
      // Cross-fade the theme change where supported; otherwise switch instantly.
      if (document.startViewTransition && !reduceMotion.matches) {
        document.startViewTransition(() => apply(mode));
      } else {
        apply(mode);
      }
    });
  }

  prefersDark.addEventListener('change', () => storedMode() === 'auto' && apply('auto'));
  apply(storedMode());
</script>
