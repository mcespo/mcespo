---
import LogoIcon from './LogoIcon.astro';

/**
 * SiteHeader — brand mark, primary nav, and the Auto / Light / Dark
 * theme pill.
 *
 * Props:
 *   currentPage — ID of the active nav item, used to set aria-current="page"
 */

interface Props {
  currentPage?: 'writing' | 'projects' | 'contact';
}

const { currentPage } = Astro.props;

const navLinks = [
  { href: '/',         label: 'Writing',  id: 'writing'  },
  { href: '/projects', label: 'Projects', id: 'projects' },
  { href: '/contact',  label: 'Say hi',   id: 'contact'  },
] as const;

const themes = [
  { id: 'auto',  label: 'Auto'  },
  { id: 'light', label: 'Light' },
  { id: 'dark',  label: 'Dark'  },
] as const;
---

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2.25rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);

    & :global(svg) {
      color: var(--ink-2);
      transition: transform .6s cubic-bezier(.3, 1.4, .5, 1), color .6s;

      @media (prefers-reduced-motion: reduce) { transition: none; }
    }

    &:hover :global(svg) {
      transform: rotate(-14deg);
      color: var(--accent);

      @media (prefers-reduced-motion: reduce) { transform: none; }
    }

    & span {
      font-family: var(--f-display);
      font-variation-settings: var(--dv);
      font-size: 1.25rem;
    }
  }

  /* Wraps under the brand on narrow screens rather than hiding the nav */
  .end {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.375rem;
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  nav {
    display: flex;
    gap: 1.25rem;

    & a[aria-current="page"] { color: var(--ink); }
  }

  .theme {
    display: flex;
    border: 1px solid var(--rule);
    border-radius: 999rem;
    padding: 0.1875rem;

    & button {
      all: unset;
      cursor: pointer;
      font-family: var(--f-body);
      font-size: 0.875rem;
      color: var(--ink-3);
      padding: 0.25rem 0.625rem;
      border-radius: 999rem;

      &[aria-pressed="true"] {
        background: var(--ink);
        color: var(--paper);
      }

      &:focus-visible { outline: 2px solid var(--accent); }
    }
  }
</style>

<header>
  <a class="brand" href="/" aria-label="Marvin Céspedes, home">
    <LogoIcon size="2.75rem" />
    <span>Marvin Céspedes</span>
  </a>

  <div class="end">
    <nav aria-label="Primary">
      {navLinks.map(({ href, label, id }) => (
        <a href={href} aria-current={currentPage === id ? 'page' : undefined}>{label}</a>
      ))}
    </nav>

    <!--
      Theme pill — reads and writes the same localStorage key used
      by the inline script in BaseLayout <head>.
    -->
    <div class="theme" role="group" aria-label="Color theme">
      {themes.map(({ id, label }) => (
        <button type="button" data-theme={id} aria-pressed="false">{label}</button>
      ))}
    </div>
  </div>
</header>

<script>
  type Mode = 'auto' | 'dark' | 'light';

  const KEY = 'mcespo.tweaks';
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme button');

  function getPrefs(): Record<string, unknown> {
    try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; }
  }

  function getMode(): Mode {
    const m = getPrefs().darkMode;
    return m === 'dark' || m === 'light' ? m : 'auto';
  }

  /* Auto: system preference first, then time of day (7 pm – 7 am = dark) */
  function autoIsDark(): boolean {
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) return true;
    if (window.matchMedia('(prefers-color-scheme: light)').matches) return false;
    const h = new Date().getHours();
    return h >= 19 || h < 7;
  }

  function apply(mode: Mode) {
    const dark = mode === 'auto' ? autoIsDark() : mode === 'dark';
    document.documentElement.classList.toggle('dark', dark);
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.theme === mode)));
  }

  buttons.forEach((b) => b.addEventListener('click', () => {
    const mode = b.dataset.theme as Mode;
    const prefs = getPrefs();
    if (mode === 'auto') { delete prefs.darkMode; } else { prefs.darkMode = mode; }
    localStorage.setItem(KEY, JSON.stringify(prefs));
    apply(mode);
  }));

  apply(getMode());

  // Re-apply when the system preference changes, but only in auto mode
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (getMode() === 'auto') apply('auto');
  });
</script>
