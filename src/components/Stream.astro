---
import { render } from 'astro:content';
import {
  type StreamItem,
  excerpt,
  isoDate,
  longDate,
  pageHref,
  readingMinutes,
  shortDate,
  titleHtml,
} from '../lib/writing';

interface Props {
  /** Already sorted, newest first. */
  items: StreamItem[];
  /** The pagination row only renders when there's more than one page. */
  page?: number;
  total?: number;
}

const { items, page = 1, total = 1 } = Astro.props;

const rendered = await Promise.all(
  items.map(async (item) =>
    item.kind === 'note' ? { ...item, Content: (await render(item.entry)).Content } : item,
  ),
);
---

<style>
  .entry {
    position: relative;
    padding-block: 3rem;
    border-block-start: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;

    & h2 {
      font-size: var(--text-entry);
      line-height: 1.08;
      letter-spacing: -0.015em;
      transition: color .2s;
    }

    /* Stretches the title link over the whole card, so there's one link per post for screen readers. */
    & h2 a::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    & h2 a:hover { color: inherit; }

    &:hover h2 { color: var(--accent-2-strong); }
  }

  .excerpt {
    font-size: var(--text-excerpt);
    line-height: 1.65;
    color: var(--ink-2);
  }

  .more {
    font-size: var(--text-ui);
    color: var(--accent-2-strong);
  }

  .note-card {
    background: var(--sticky);
    color: var(--sticky-ink);
    border-radius: 0.625rem;
    padding: 1.5rem 1.75rem;
    margin-block-end: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    rotate: -0.4deg;

    & .meta {
      color: var(--sticky-ink);
      opacity: 0.75;
    }
  }

  .body {
    font-size: var(--text-excerpt);
    line-height: 1.6;

    & :global(p + p) { margin-block-start: 0.75rem; }
    & :global(a) { text-decoration: underline; }
    & :global(code) { background: color-mix(in oklch, var(--sticky-ink) 10%, transparent); }
  }

  .pages {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
    border-block-start: 1px solid var(--rule);
    font-size: var(--text-ui);

    & p { color: var(--ink-3); }

    & div {
      display: flex;
      gap: 1.25rem;
    }
  }
</style>

{rendered.map((item) =>
  item.kind === 'post' ? (
    <article class="entry">
      <p class="meta">
        <time datetime={isoDate(item.entry.data.publishDate)}>{longDate(item.entry.data.publishDate)}</time>
        · {item.entry.data.category}
      </p>
      <h2><a href={`/posts/${item.entry.id}`} set:html={titleHtml(item.entry.data.title)} /></h2>
      <p class="excerpt">{excerpt(item.entry)}</p>
      <p class="more">Continue reading, {readingMinutes(item.entry)} min</p>
    </article>
  ) : (
    <article class="note-card" aria-label="Note">
      <p class="meta">
        <time datetime={isoDate(item.entry.data.publishDate)}>{shortDate(item.entry.data.publishDate)}</time>
        · A note
      </p>
      <div class="body"><item.Content /></div>
    </article>
  ),
)}

{total > 1 && (
  <nav class="pages" aria-label="Pagination">
    <p>Page {page} of {total}</p>
    <div>
      {page > 1 && <a class="u" href={pageHref(page - 1)}>Newer posts</a>}
      {page < total && <a class="u" href={pageHref(page + 1)}>Older posts</a>}
    </div>
  </nav>
)}
