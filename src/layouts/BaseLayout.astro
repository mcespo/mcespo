---
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LogoSprite from '../components/LogoSprite.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute canonical URL; defaults to the current page. */
  canonical?: string;
  /** Absolute OG image URL. Image tags are omitted without one rather than pointing at a missing file. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Highlights the matching nav item. */
  nav?: 'writing' | 'projects' | 'contact';
}

const {
  title,
  description = 'Designer, maker, occasional writer.',
  canonical,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  schema,
  nav,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// Only the roman Latin cuts are needed above the fold; italics and code load on demand.
const preload = [{ style: 'normal', subset: 'latin' }];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <!-- Generated by `npm run favicons`. sizes="32x32" stops Chrome preferring the ICO over the SVG. -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title="Marvin Céspedes" href="/feed.xml" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Marvin Céspedes" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

  <Font cssVariable="--font-fraunces" preload={preload} />
  <Font cssVariable="--font-newsreader" preload={preload} />
  <Font cssVariable="--font-jetbrains" />

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <!--
    Must run before first paint to avoid a theme flash, so it's inline and can't import
    the header's module; keep the auto rule in sync with SiteHeader.
  -->
  <script is:inline>
    try {
      const { darkMode } = JSON.parse(localStorage.getItem('mcespo.tweaks') ?? '{}');
      const hour = new Date().getHours();
      const dark =
        darkMode === 'dark' ||
        (darkMode !== 'light' &&
          (matchMedia('(prefers-color-scheme: dark)').matches ||
            (!matchMedia('(prefers-color-scheme: light)').matches && (hour >= 19 || hour < 7))));
      document.documentElement.classList.toggle('dark', dark);
    } catch {}
  </script>
</head>

<body>
  <LogoSprite />
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="col">
    <SiteHeader current={nav} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </div>
</body>
</html>
