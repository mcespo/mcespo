---
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LogoSprite from '../components/LogoSprite.astro';
import { site } from '../site.config';
import { graph, person, webPage, website, type PageType } from '../lib/schema';
import '../styles/global.css';

interface Props {
  /** Page name without the site name; omit on the homepage. */
  title?: string;
  description?: string;
  /** Social share image; site-relative or absolute. Defaults to the site card. */
  image?: { src: string; alt: string; width?: number; height?: number };
  /** Adds article:* tags and og:type=article. */
  article?: { published: Date; section?: string; tags?: string[] };
  /** Schema.org type for this page's WebPage node. */
  pageType?: PageType;
  /** Extra schema nodes, e.g. a BlogPosting, added to the shared graph. */
  schema?: Record<string, unknown>[];
  /** Highlights the matching nav item. */
  nav?: 'writing' | 'projects' | 'contact';
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  article,
  pageType,
  schema = [],
  nav,
} = Astro.props;

// Social cards show og:site_name separately, so og:title drops the suffix the tab title gets.
const pageTitle = title ?? `${site.name} — ${site.person.jobTitle} & Designer`;
const documentTitle = title ? `${title} — ${site.name}` : pageTitle;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image.src, Astro.site).href;
const imageType = image.src.endsWith('.png') ? 'image/png' : image.src.match(/\.jpe?g$/) ? 'image/jpeg' : undefined;

const jsonLd = graph([
  website(),
  person(),
  webPage({ url: canonicalUrl, title: pageTitle, description, image: imageUrl, type: pageType }),
  ...schema,
]);

// Only the roman cuts are needed above the fold; italics and code load on demand.
const preload = [{ style: 'normal' }];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{documentTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={site.name} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <!-- Generated by `npm run brand-images`. sizes="32x32" stops Chrome preferring the ICO over the SVG. -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Open Graph covers Slack, iMessage, LinkedIn, Facebook and Discord; X reads it too, apart from the card type. -->
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  {imageType && <meta property="og:image:type" content={imageType} />}
  {image.width && <meta property="og:image:width" content={String(image.width)} />}
  {image.height && <meta property="og:image:height" content={String(image.height)} />}
  <meta property="og:image:alt" content={image.alt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image:alt" content={image.alt} />
  {article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      <meta property="article:author" content={new URL('/', Astro.site).href} />
      {article.section && <meta property="article:section" content={article.section} />}
      {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )}

  <Font cssVariable="--font-fraunces" preload={preload} />
  <Font cssVariable="--font-newsreader" preload={preload} />
  <Font cssVariable="--font-jetbrains" />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!--
    Must run before first paint to avoid a theme flash, so it's inline and can't import
    the header's module; keep the auto rule in sync with SiteHeader.
  -->
  <script is:inline>
    try {
      const { darkMode } = JSON.parse(localStorage.getItem('mcespo.tweaks') ?? '{}');
      const hour = new Date().getHours();
      const dark =
        darkMode === 'dark' ||
        (darkMode !== 'light' &&
          (matchMedia('(prefers-color-scheme: dark)').matches ||
            (!matchMedia('(prefers-color-scheme: light)').matches && (hour >= 19 || hour < 7))));
      document.documentElement.classList.toggle('dark', dark);
    } catch {}
  </script>
</head>

<body>
  <LogoSprite />
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="col">
    <SiteHeader current={nav} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </div>
</body>
</html>
