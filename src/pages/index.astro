---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

const askMe = `mailto:${site.email}?${new URLSearchParams({
  subject: "Oh hello Marvin, you're so cool!",
  body: 'I wish to be marginally as attractive as you are. Please help! Also, I wanted to ask...',
}).toString().replaceAll('+', '%20')}`;
---

<style>
  /* The shared intro spacing is sized for a post list; the bio follows more closely. */
  .intro {
    padding-block-end: 1.625rem;
    --reveal-offset: 120ms;
  }

  .bio {
    --reveal-offset: 340ms;
    font-size: 1.3125rem;
    line-height: 1.7;

    & p + p { margin-block-start: 1.625rem; }

    @media (width <= 37.5rem) { font-size: 1.1875rem; }
  }

  .sign {
    margin-block-start: 2.5rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.875rem;
  }
</style>

<BaseLayout pageType="ProfilePage">
  <section class="intro reveal-group" aria-labelledby="hello">
    <h1 id="hello">Howdy, I’m Marvin.</h1>
    <p>
      I’m a software engineer and designer in beautiful (and mostly chilly) Chicago.
      I build for the web, with a soft spot for the frontend and accessibility.
    </p>
  </section>

  <div class="bio reveal-group">
    <p>
      These days I’m at <a class="u" href="https://www.kin.com/">Kin</a>, where I look after
      the main marketing site. It runs on <a class="u" href="https://www.content.one/">Content.One</a>.
    </p>
    <p>
      Before that, I built software for <a class="u" href="https://www.3zbrands.com/">3Z Brands</a>,
      <a class="u" href="https://www.benchmarkanalytics.com/">Benchmark Analytics</a>, and
      <a class="u" href="https://www.grainger.com/">Grainger</a>. I also worked on the internal design
      system at Epsilon (formerly Conversant Media), Vox Media’s
      <a class="u" href="https://concert.io/">Concert ad units</a>, and the
      <a class="u" href="https://www.chicityclerk.com/">Office of the Chicago City Clerk</a>.
    </p>
    <p>
      Along the way, I’ve volunteered as a designer and webmaster for
      <a class="u" href="http://a4th.org/">Artists for the Humanities</a> and
      <a class="u" href="https://intersectionchicago.org/">Intersection</a>, and taught with
      <a class="u" href="https://www.girldevelopit.com/">Girl Develop It Chicago</a>.
    </p>
    <p>
      I also shoot photos and video, make wicked-good coffee, and answer to a golden retriever
      and two kids.
    </p>
    <p>Want to say hi? <a class="u" href={askMe}>Ask me something</a>.</p>
    <p class="sign">Stay safe out there.</p>
  </div>
</BaseLayout>
