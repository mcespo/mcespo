---
/**
 * Tag page — every post filed under a tag or category.
 * Pinned tags from site.config get a page even before they're used.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Stream from '../../components/Stream.astro';
import { getPosts, postTags, tagSlug } from '../../lib/writing';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Set([...site.pinnedTags.map(tagSlug), ...posts.flatMap(postTags)]);

  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      items: posts
        .filter((post) => postTags(post).includes(tag))
        .map((entry) => ({ kind: 'post' as const, entry })),
    },
  }));
}

const { tag, items } = Astro.props;
const label = tag.replace(/-/g, ' ');
---

<BaseLayout
  title={`Filed under ${label} — Marvin Céspedes`}
  description={`Posts about ${label}.`}
>
  <div class="col">
    <SiteHeader currentPage="writing" />

    <main>
      <header class="intro">
        <h1>Filed under <em>{label}</em>.</h1>
        <p>
          {items.length > 0
            ? `${items.length} ${items.length === 1 ? 'post' : 'posts'}, newest first.`
            : 'Nothing here yet. It’s on the list.'}
        </p>
      </header>

      <Stream items={items} />
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
