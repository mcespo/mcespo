---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stream from '../../components/Stream.astro';
import { getPosts, postTags, tagSlug } from '../../lib/writing';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Pinned tags get a page before any post uses them, so the homepage intro never links to a 404.
  const tags = new Set([...site.pinnedTags.map(tagSlug), ...posts.flatMap(postTags)]);

  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      items: posts
        .filter((post) => postTags(post).includes(tag))
        .map((entry) => ({ kind: 'post' as const, entry })),
    },
  }));
}

const { tag, items } = Astro.props;
const label = tag.replaceAll('-', ' ');
---

<BaseLayout
  title={`Filed under ${label} — Marvin Céspedes`}
  description={`Posts about ${label}.`}
  nav="writing"
>
  <header class="intro">
    <h1>Filed under <em>{label}</em>.</h1>
    <p>
      {items.length > 0
        ? `${items.length} ${items.length === 1 ? 'post' : 'posts'}, newest first.`
        : 'Nothing here yet. It’s on the list.'}
    </p>
  </header>

  <Stream items={items} />
</BaseLayout>
