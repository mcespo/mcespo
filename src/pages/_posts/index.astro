---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stream from '../../components/Stream.astro';
import { getStream } from '../../lib/writing';
import { site } from '../../site.config';

const stream = await getStream();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${site.name} — Writing`,
  url: 'https://mcespo.com/posts',
  description: 'Essays, notes, and things I needed to write down.',
  author: { '@type': 'Person', name: site.name, url: 'https://mcespo.com' },
};
---

<BaseLayout
  title="Writing — Marvin Céspedes"
  description="Essays, notes, and things I needed to write down."
  schema={schema}
  nav="writing"
>
  <header class="intro">
    <h1>Everything, so far.</h1>
    <p>Essays, notes, and things I needed to write down — newest first.</p>
  </header>

  <Stream items={stream} />
</BaseLayout>
