---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChicagoStars from '../../components/ChicagoStars.astro';
import {
  type Post,
  getPosts,
  isoDate,
  longDate,
  readingMinutes,
  tagHref,
  titleHtml,
  titleText,
} from '../../lib/writing';
import { site } from '../../site.config';
import { blog, blogPosting } from '../../lib/schema';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // "Next" follows the stream's reading order, so it's the next older post.
    props: { post, next: posts[i + 1] ?? null },
  }));
}

interface Props {
  post: Post;
  next: Post | null;
}

const { post, next } = Astro.props;
const { Content } = await render(post);

const title = titleText(post.data.title);
const writeBack = `mailto:${site.email}?subject=${encodeURIComponent(`Re: ${title}`)}`;
// A post's hero doubles as its share image; otherwise the site card stands in.
const image = post.data.heroImage
  ? { src: post.data.heroImage, alt: post.data.heroImageAlt ?? '' }
  : site.ogImage;
const url = new URL(Astro.url.pathname, Astro.site).href;
const schema = [blog(), blogPosting(post, url, new URL(image.src, Astro.site).href)];
---

<style>
  header {
    padding-block: 6rem 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;

    & h1 {
      font-size: var(--text-title);
      line-height: 1;
      letter-spacing: -0.02em;
      font-weight: 360;
      max-inline-size: 40rem;
    }
  }

  .dek {
    font-size: var(--text-lede);
    line-height: 1.45;
    color: var(--ink-2);
    max-inline-size: 33.75rem;
  }

  .next {
    margin-block-start: 3.5rem;
    font-size: var(--text-ui);
    line-height: 1.6;
  }
</style>

<BaseLayout
  title={title}
  description={post.data.description}
  image={image}
  article={{ published: post.data.publishDate, section: post.data.category, tags: post.data.tags }}
  schema={schema}
  nav="writing"
>
  <article>
    <header>
      <p class="meta">
        <a class="u" href={tagHref(post.data.category)}>{post.data.category}</a>
        · <time datetime={isoDate(post.data.publishDate)}>{longDate(post.data.publishDate)}</time>
        · {readingMinutes(post)} min read
      </p>
      <h1 set:html={titleHtml(post.data.title)} />
      <p class="dek">{post.data.description}</p>
    </header>

    <ChicagoStars />

    <div class="art">
      <Content />
      <p class="sign">— Marvin</p>
    </div>
  </article>

  <p class="next">
    {next ? (
      <>If you liked this, the next one is <a class="u" href={`/posts/${next.id}`}>{titleText(next.data.title)}</a>. Or </>
    ) : (
      <>If you liked this, </>
    )}<a class="u" href={writeBack}>write back</a> — I read everything.
  </p>
</BaseLayout>
