---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChicagoStars from '../../components/ChicagoStars.astro';
import {
  type Post,
  getPosts,
  isoDate,
  longDate,
  readingMinutes,
  tagHref,
  titleHtml,
  titleText,
} from '../../lib/writing';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // "Next" follows the stream's reading order, so it's the next older post.
    props: { post, next: posts[i + 1] ?? null },
  }));
}

interface Props {
  post: Post;
  next: Post | null;
}

const { post, next } = Astro.props;
const { Content } = await render(post);

const title = titleText(post.data.title);
const writeBack = `mailto:${site.email}?subject=${encodeURIComponent(`Re: ${title}`)}`;
const author = { '@type': 'Person', name: site.name, url: 'https://mcespo.com' };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  keywords: post.data.tags.join(', '),
  url: new URL(`/posts/${post.id}`, Astro.site).href,
  author,
  publisher: author,
};
---

<style>
  header {
    padding-block: 6rem 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;

    & .meta a { color: var(--accent); }

    & h1 {
      font-size: 4.25rem;
      line-height: 1;
      letter-spacing: -0.02em;
      font-weight: 360;
      max-inline-size: 40rem;

      @media (width <= 37.5rem) { font-size: 2.875rem; }
    }
  }

  .dek {
    font-size: 1.4375rem;
    line-height: 1.45;
    color: var(--ink-2);
    max-inline-size: 33.75rem;
  }

  .next {
    margin-block-start: 3.5rem;
    font-size: 1.1875rem;
    line-height: 1.6;
  }
</style>

<BaseLayout
  title={`${title} — Marvin Céspedes`}
  description={post.data.description}
  ogImage={post.data.heroImage && new URL(post.data.heroImage, Astro.site).href}
  ogImageAlt={post.data.heroImageAlt}
  ogType="article"
  schema={schema}
  nav="writing"
>
  <article>
    <header>
      <p class="meta">
        <a class="u" href={tagHref(post.data.category)}>{post.data.category}</a>
        · <time datetime={isoDate(post.data.publishDate)}>{longDate(post.data.publishDate)}</time>
        · {readingMinutes(post)} min read
      </p>
      <h1 set:html={titleHtml(post.data.title)} />
      <p class="dek">{post.data.description}</p>
    </header>

    <ChicagoStars />

    <div class="art">
      <Content />
      <p class="sign">— Marvin</p>
    </div>
  </article>

  <p class="next">
    {next ? (
      <>If you liked this, the next one is <a class="u" href={`/posts/${next.id}`}>{titleText(next.data.title)}</a>. Or </>
    ) : (
      <>If you liked this, </>
    )}<a class="u" href={writeBack}>write back</a> — I read everything.
  </p>
</BaseLayout>
