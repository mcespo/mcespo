---
/**
 * Posts index — the full archive: every post and note, newest first.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Stream from '../../components/Stream.astro';
import { getStream } from '../../lib/writing';

const stream = await getStream();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Marvin Céspedes — Writing',
  url: 'https://mcespo.com/posts',
  description: 'Essays, notes, and things I needed to write down.',
  author: {
    '@type': 'Person',
    name: 'Marvin Céspedes',
    url: 'https://mcespo.com',
  },
};
---

<BaseLayout
  title="Writing — Marvin Céspedes"
  description="Essays, notes, and things I needed to write down."
  schema={schema}
>
  <div class="col">
    <SiteHeader currentPage="writing" />

    <main>
      <header class="intro">
        <h1>Everything, so far.</h1>
        <p>Essays, notes, and things I needed to write down — newest first.</p>
      </header>

      <Stream items={stream} />
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
